{"name": "pi-jupyter", "version": "2.5.0", "private": true, "type": "module", "description": "Remote Jupyter-backed REPL for pi coding agents. Pure TypeScript, no local backend \u2014 runs code (Python, R, \u2026) on a remote Jupyter Server via @jupyterlab/services. The kernel is discovered and chosen by the agent per call; the server connection is user-configured. Hexagonal architecture: pure domain core behind a KernelPort seam.", "author": "pi-jupyter contributors", "license": "BSD-3-Clause", "keywords": ["pi-package", "jupyter", "python", "repl", "notebook", "remote", "agent"], "pi": {"extensions": ["./extensions/repl.ts"]}, "files": ["README.md", "extensions", "src"], "scripts": {"typecheck": "tsc --noEmit", "build": "tsup", "test": "vitest run", "test:watch": "vitest", "test:integration": "node --import tsx test/integration/smoke.test.ts", "test:all": "vitest run && npm run test:integration"}, "dependencies": {"@jupyterlab/services": "^7.5.0"}, "peerDependencies": {"@earendil-works/pi-ai": "*", "@earendil-works/pi-coding-agent": "*", "@earendil-works/pi-tui": "*", "typebox": "*"}, "devDependencies": {"@earendil-works/pi-ai": "^0.74.2", "@earendil-works/pi-coding-agent": "^0.74.2", "@earendil-works/pi-tui": "^0.74.2", "@types/node": "^22.20.1", "tsup": "^8.5.0", "tsx": "^4.23.1", "typebox": "^1.3.8", "typescript": "^5.9.3", "vitest": "^3.2.4"}}